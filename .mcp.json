{
  "mcpServers": {
    "stuntdouble": {
      "type": "http",
      "url": "https://app.stuntdouble.io/api/mcp"
    },
    "local": {
      "command": "npx",
      "args": ["-y", "stuntdouble@0.1.3", "mcp"],
      "env": {
        "STUNTDOUBLE_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}"
      }
    }
  }
}
